Cell[BoxData[{
 RowBox[{
  RowBox[{"zMin", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zMax", "=", "1"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"plt", "=", 
   RowBox[{"ListDensityPlot", "[", 
    RowBox[{"flattenedAKX1", ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<\[Kappa]\>\""}], "}"}]}], ",", 
     RowBox[{"InterpolationOrder", "->", "2"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"FontSize", "->", "14"}], "]"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{"disable", " ", "auto\:2011scaling", " ", "so", " ", 
       RowBox[{"\[OpenCurlyDoubleQuote]", "#", "\[CloseCurlyDoubleQuote]"}], 
       " ", "is", " ", "the", " ", "raw", " ", "z", " ", "value"}], "*)"}], 
     RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
     RowBox[{"(*", 
      RowBox[{"single", "\[Hyphen]", 
       RowBox[{
       "argument", " ", "function", " ", "for", " ", "density", " ", 
        "plots"}]}], "*)"}], 
     RowBox[{"ColorFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "z", "}"}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"z", "<", "zMin"}], ",", 
          RowBox[{"(*", 
           RowBox[{
           "everything", " ", "below", " ", "0", " ", "gets", " ", "gray"}], 
           "*)"}], 
          RowBox[{"GrayLevel", "[", "0.85", "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"everything", " ", "0"}], "\[Dash]", 
            RowBox[{"1", " ", "gets", " ", "the", " ", "reversed"}], 
            "\[Hyphen]", 
            RowBox[{"Sunset", " ", "ramp"}]}], "*)"}], 
          RowBox[{
           RowBox[{"ColorData", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<SunsetColors\>\"", ",", "\"\<Reverse\>\""}], "}"}], 
            "]"}], "[", 
           RowBox[{"Rescale", "[", 
            RowBox[{"z", ",", 
             RowBox[{"{", 
              RowBox[{"zMin", ",", "zMax"}], "}"}]}], "]"}], "]"}]}], "]"}]}],
        "]"}]}], ",", 
     RowBox[{"(*", 
      RowBox[{
      "manually", " ", "build", " ", "a", " ", "legend", " ", "only", " ", 
       RowBox[{"for", "[", 
        RowBox[{"0", ",", "1"}], "]"}]}], "*)"}], 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"BarLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ColorData", "[", 
           RowBox[{"{", 
            RowBox[{"\"\<SunsetColors\>\"", ",", "\"\<Reverse\>\""}], "}"}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
        RowBox[{"LegendLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"\[Alpha]", ",", "\"\<eff\>\""}], "]"}], ",", "14"}], 
          "]"}]}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"FontSize", "->", "12"}], "]"}]}]}], "]"}]}]}], "]"}]}], 
  "\n", "\[IndentingNewLine]"}], "\n"}], "Input",
