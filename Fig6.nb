Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Parameter", " ", "ranges"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"alphaVals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", "1", ",", "0.001"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kappaVals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", "1", ",", "0.001"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nA", "=", 
     RowBox[{"Length", "[", "alphaVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nK", "=", 
     RowBox[{"Length", "[", "kappaVals", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data1", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"nA", ",", "nK"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"choose", " ", "a", " ", "high", " ", "recursion", " ", "limit"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxRec", "=", "10000"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"alphaVals", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"k", "=", 
        RowBox[{"kappaVals", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x0", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"j", "==", "1"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "<=", "0.7"}], "&&", 
             RowBox[{"k", "<=", "0.7"}]}], ")"}]}], ",", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"a", "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"1", "/", "4"}], "-", 
               RowBox[{"a", "^", "2"}]}], ")"}], " ", "k"}]}], "]"}], ",", 
          "0.8"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "locally", " ", "raise", " ", "the", " ", "recursion", " ", "limit", 
         " ", "for", " ", "this", " ", "FindRoot"}], "*)"}], 
       RowBox[{"solRule", "=", 
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"RecursionLimit", "=", "maxRec"}], "}"}], ",", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"FindRoot", "[", 
             RowBox[{
              RowBox[{"eqn", "[", 
               RowBox[{"x", ",", "a", ",", "k"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "x0"}], "}"}]}], "]"}], ",", 
            RowBox[{"(*", 
             RowBox[{"on", " ", "any", " ", "FindRoot", " ", "failure"}], 
             "*)"}], 
            RowBox[{"{", 
             RowBox[{"x", "->", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"data1", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
        RowBox[{"x", "/.", " ", "solRule"}]}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nA"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "nK"}], "}"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"flattenedAKX1", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"alphaVals", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"kappaVals", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", 
           RowBox[{"data1", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "alphaVals", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "kappaVals", "]"}]}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.962431173837524*^9, 3.962431200930458*^9}, {
  3.962432496745167*^9, 3.962432497250537*^9}, {3.962432618845645*^9, 
