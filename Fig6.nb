Notebook[{

Cell[CellGroupData[{
Cell["FINDING EFFECITVE \[Alpha]", "Subsection",
 CellChangeTimes->{{3.958452680476408*^9, 
  3.95845269925529*^9}},ExpressionUUID->"7e4b3f3f-ca78-4935-97f4-\
f5028e89215f"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "On", " ", "this", " ", "notebook", " ", "I", " ", "examine", " ", "the", 
   " ", "possibilities", " ", "of", " ", "having", " ", "an", " ", 
   "effective", " ", "alpha", " ", "that", " ", "encodes", " ", "the", " ", 
   "effect", " ", "of", " ", "the", " ", "dissipation", " ", "kappa"}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.9583907323080883`*^9, 3.95839076434518*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"eb97682d-b060-4c5f-8244-d93a3d3293a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "\[Alpha]_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "72"], " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      SuperscriptBox["\[Alpha]", "2"]}]], " ", 
    RowBox[{"(", 
     RowBox[{"72", "-", 
      RowBox[{"288", " ", 
       SuperscriptBox["\[Alpha]", "2"]}], "+", 
      RowBox[{"276", " ", 
       SuperscriptBox["\[Alpha]", "4"]}], "-", 
      RowBox[{"128", " ", 
       SuperscriptBox["\[Alpha]", "6"]}], "+", 
      RowBox[{"25", " ", 
       SuperscriptBox["\[Alpha]", "8"]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["\[Alpha]", "10"]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"eqn", "[", 
    RowBox[{"x_", ",", "\[Alpha]_", ",", "\[Kappa]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"4", "+", 
     RowBox[{"12", " ", 
      RowBox[{"f", "[", "\[Alpha]", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "\[Kappa]"}], ")"}]}], "-", 
     RowBox[{"3", " ", "\[Kappa]"}]}], "==", 
    RowBox[{"4", "+", 
     RowBox[{"12", " ", 
      RowBox[{"f", "[", "x", "]"}]}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9584523689354267`*^9, 3.9584523700221024`*^9}, {
   3.962275986703026*^9, 3.962275987413533*^9}, 3.9622760551377563`*^9, {
   3.9622762062195063`*^9, 3.962276207150421*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"5c5b28fb-883d-4d2e-ad47-3c2b08053130"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Parameter", " ", "ranges"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"alphaVals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", "1", ",", "0.01"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kappaVals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", "1", ",", "0.01"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nA", "=", 
     RowBox[{"Length", "[", "alphaVals", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nK", "=", 
     RowBox[{"Length", "[", "kappaVals", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data1", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", 
       RowBox[{"{", 
        RowBox[{"nA", ",", "nK"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"alphaVals", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";", 
       RowBox[{"k", "=", 
        RowBox[{"kappaVals", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"x0", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"j", "==", "1"}], " ", "||", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "<=", "0.7"}], " ", "&&", " ", 
             RowBox[{"k", " ", "<=", "0.7"}]}], ")"}]}], ",", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{
            RowBox[{"a", "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"1", "/", "4"}], "-", 
               RowBox[{"a", "^", "2"}]}], ")"}], " ", "k"}]}], "]"}], ",", 
          RowBox[{"data1", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", 
             RowBox[{"j", "-", "1"}]}], "]"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sol", "=", 
        RowBox[{"FindRoot", "[", 
         RowBox[{
          RowBox[{"eqn", "[", 
           RowBox[{"x", ",", "a", ",", "k"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "x0"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"data1", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
        RowBox[{"x", "/.", " ", "sol"}]}], ";"}], " ", ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "nA"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "nK"}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"flattenedAKX", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"alphaVals", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{"kappaVals", "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", 
           RowBox[{"data1", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "alphaVals", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "kappaVals", "]"}]}], "}"}]}], "]"}], ",", 
       "1"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"exact", " ", "solution"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.958451307187278*^9, 3.958451309379533*^9}, {
   3.9585368025280323`*^9, 3.958536821343815*^9}, 3.958539345144353*^9, {
   3.958542052017675*^9, 3.958542056140967*^9}, {3.962275899231563*^9, 
   3.9622759000580177`*^9}, {3.962276007334633*^9, 3.962276011552184*^9}, {
   3.962276403005294*^9, 3.9622764236548767`*^9}, {3.9624308337472887`*^9, 
   3.962430835403099*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"63133413-38a8-4162-a1a2-76a744842a42"],

Cell["Now I plot the heat map of the effective kappa and alpha. ", "Text",
 CellChangeTimes->{{3.9622760991658497`*^9, 
  3.962276125419078*^9}},ExpressionUUID->"e7f6a9bd-5ebd-4183-b949-\
dd8ae08c653f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListDensityPlot", "[", 
    RowBox[{"flattenedAKX", ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<\[Kappa]\>\""}], "}"}]}], ",", 
     RowBox[{"ColorFunction", "->", 
      RowBox[{"ColorData", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<SunsetColors\>\"", ",", "\"\<Reverse\>\""}], "}"}], 
       "]"}]}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}], ",", " ", 
     RowBox[{"InterpolationOrder", "->", "2"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"FontSize", "->", "14"}], "]"}]}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9622760186372023`*^9, 3.9622760454644327`*^9}, {
  3.9622760900630007`*^9, 3.962276092016481*^9}, {3.962276483636651*^9, 
  3.962276484933517*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"8397947e-a537-437f-a932-b6ebf488ec18"],

