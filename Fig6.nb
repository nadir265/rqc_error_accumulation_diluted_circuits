Cell["\<\
Let us compute now the difference on fidelities. When considering this, there \
is a curse of dimensionality.  \
\>", "Text",
 CellChangeTimes->{{3.962276186850058*^9, 3.962276198995996*^9}, {
   3.96227719747649*^9, 3.9622772551644897`*^9}, {3.96227729457944*^9, 
   3.96227730898899*^9}, 
   3.962277362480442*^9},ExpressionUUID->"06278232-9878-47bf-9958-\
9ff1042658e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fiddis", "[", 
    RowBox[{"L_", ",", "t_", ",", "\[Alpha]_", ",", "\[Kappa]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["2", "L"]], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"4", "+", 
              RowBox[{"12", 
               RowBox[{"f", "[", "\[Alpha]", "]"}], 
               RowBox[{"(", 
                RowBox[{"1", "-", "\[Kappa]"}], ")"}]}], "-", 
              RowBox[{"3", "\[Kappa]"}]}], ")"}], 
            RowBox[{"L", "/", "2"}]], "-", "1"}], 
          RowBox[{
           SuperscriptBox["4", "L"], "-", "1"}]], ")"}], "t"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["2", "L"], "-", "1"}], ")"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fid", "[", 
    RowBox[{"L_", ",", "t_", ",", "\[Alpha]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     SuperscriptBox["2", "L"]], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"4", "+", 
              RowBox[{"12", 
               RowBox[{"f", "[", "\[Alpha]", "]"}]}]}], ")"}], 
            RowBox[{"L", "/", "2"}]], "-", "1"}], 
          RowBox[{
           SuperscriptBox["4", "L"], "-", "1"}]], ")"}], "t"], 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["2", "L"], "-", "1"}], ")"}]}]}], ")"}]}]}], 
  ";"}]}], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"e5e8fb91-af6f-427b-8b6b-09dc418341a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"DeltaFid", "[", 
   RowBox[{"L_", ",", "t_"}], "]"}], ":=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"flattenedAKX", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
      RowBox[{"flattenedAKX", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"fiddis", "[", 
         RowBox[{"L", ",", "t", ",", 
          RowBox[{"flattenedAKX", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"flattenedAKX", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], "]"}], "-", 
        RowBox[{"fid", "[", 
         RowBox[{"L", ",", "t", ",", 
          RowBox[{"flattenedAKX", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "3"}], "]"}], "]"}]}], "]"}]}], "]"}]}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "flattenedAKX", "]"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9622762391903973`*^9, 3.962276399724469*^9}, {
  3.9622764402149677`*^9, 3.962276478071102*^9}, {3.962276656815743*^9, 
  3.962276679066656*^9}, {3.962276822966717*^9, 3.9622768353822412`*^9}, {
  3.962277322354813*^9, 3.9622773351414757`*^9}, {3.962277365844986*^9, 
  3.962277367000513*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"402a80b9-548a-4c7f-b82c-0af1421b7ad6"],

Cell["For 8 probably I have numerical issues.", "Text",
 CellChangeTimes->{{3.962277376228367*^9, 
  3.9622774044548197`*^9}},ExpressionUUID->"c86daf76-dee5-4e7f-95a6-\
0d0ee58f7d4c"],

Cell["\<\
Hence, it is much visual to compare the core of the equation, removing all \
dependence on time and number of qubits. \
\>", "Text",
 CellChangeTimes->{{3.9622774091039267`*^9, 
  3.9622774485990047`*^9}},ExpressionUUID->"26adb5fc-1f23-46d2-a14f-\
